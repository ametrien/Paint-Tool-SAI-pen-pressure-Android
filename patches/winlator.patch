--- a/app/build.gradle
+++ b/app/build.gradle
@@ -5,14 +5,45 @@ android {
     compileSdk 35
 
     defaultConfig {
-        applicationId 'com.winlator'
+        /* SAI Pen: its own package, so it installs next to Winlator. Exactly as
+         * long as com.winlator: build.sh rewrites the path in the prebuilt
+         * binaries in place (tools/rewrite_tar.py) */
+        applicationId 'sai.penpress'
         minSdkVersion 26
         targetSdkVersion 28
-        versionCode 33
-        versionName "11.2"
+        versionCode 35
+        versionName "0.4.19"
+    }
+
+    /* SAI Pen: the release key lives outside the repository (build.sh says
+     * where); without it there is no release build, only debug */
+    def releaseProps = new Properties()
+    def releasePropsFile = file(System.getenv('SAIPEN_RELEASE_KEY') ?: "${System.getProperty('user.home')}/Documents/sai-android-build/release-key/keystore.properties")
+    if (releasePropsFile.exists()) releasePropsFile.withInputStream { releaseProps.load(it) }
+
+    signingConfigs {
+        if (releaseProps['storeFile']) {
+            release {
+                storeFile file(releaseProps['storeFile'])
+                storePassword releaseProps['storePassword']
+                keyAlias releaseProps['keyAlias']
+                keyPassword releaseProps['keyPassword']
+            }
+        }
     }
 
     buildTypes {
+        /* SAI Pen: what is given to others. Not debuggable, so Android
+         * compiles the app ahead of time; same shrinking as debug */
+        release {
+            minifyEnabled true
+            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'
+            if (releaseProps['storeFile']) signingConfig signingConfigs.release
+
+            ndk {
+                abiFilters 'arm64-v8a'
+            }
+        }
         debug {
             minifyEnabled true
             proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-rules.pro'
@@ -27,6 +58,15 @@ android {
         checkReleaseBuilds false
     }
 
+    /* SAI Pen: on Android InetAddress.getLoopbackAddress() is always ::1;
+     * the Mac's JVM says 127.0.0.1 unless it prefers IPv6. With this the
+     * unit tests see what the tablet sees (PenSampleSenderTest). */
+    testOptions {
+        unitTests.all {
+            jvmArgs '-Djava.net.preferIPv6Addresses=true'
+        }
+    }
+
     ndkVersion '24.0.8215888'
 
     externalNativeBuild {
