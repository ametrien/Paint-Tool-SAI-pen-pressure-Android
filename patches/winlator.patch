@@ -168,4 +168,53 @@ Java_com_winlator_core_GPUHelper_destroyOffscreenEGLContext(JNIEnv *env, jclass
     EGLDisplay eglDisplay = eglGetDisplay(EGL_DEFAULT_DISPLAY);
     eglMakeCurrent(eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
     eglDestroyContext(eglDisplay, (EGLContext)contextPtr);
-}
\ No newline at end of file
+}
+/*
+ * SAI Pen: when a frame of the app reached the glass, from Android's own
+ * frame timestamps (EGL_ANDROID_get_frame_timestamps). Only reads times;
+ * nothing about how frames are drawn changes. Used by
+ * com.winlator.saipen.GlassTimes on the GL thread, with the context current.
+ */
+#include <EGL/eglext.h>
+
+static PFNEGLGETNEXTFRAMEIDANDROIDPROC getNextFrameId;
+static PFNEGLGETFRAMETIMESTAMPSANDROIDPROC getFrameTimestamps;
+
+/* 1: timestamps are on for the current surface; 0: not supported here */
+JNIEXPORT jint JNICALL
+Java_com_winlator_saipen_GlassTimes_nativeEnable(JNIEnv *env, jclass cls) {
+    EGLDisplay dpy = eglGetCurrentDisplay();
+    EGLSurface surf = eglGetCurrentSurface(EGL_DRAW);
+    if (dpy == EGL_NO_DISPLAY || surf == EGL_NO_SURFACE) return 0;
+    const char *ext = eglQueryString(dpy, EGL_EXTENSIONS);
+    if (ext == NULL || strstr(ext, "EGL_ANDROID_get_frame_timestamps") == NULL) return 0;
+    getNextFrameId = (PFNEGLGETNEXTFRAMEIDANDROIDPROC) eglGetProcAddress("eglGetNextFrameIdANDROID");
+    getFrameTimestamps = (PFNEGLGETFRAMETIMESTAMPSANDROIDPROC) eglGetProcAddress("eglGetFrameTimestampsANDROID");
+    if (getNextFrameId == NULL || getFrameTimestamps == NULL) return 0;
+    return eglSurfaceAttrib(dpy, surf, EGL_TIMESTAMPS_ANDROID, EGL_TRUE) ? 1 : 0;
+}
+
+/* the id the next eglSwapBuffers will give its frame, -1 if unknown */
+JNIEXPORT jlong JNICALL
+Java_com_winlator_saipen_GlassTimes_nativeNextFrameId(JNIEnv *env, jclass cls) {
+    if (getNextFrameId == NULL) return -1;
+    EGLuint64KHR id = 0;
+    if (!getNextFrameId(eglGetCurrentDisplay(), eglGetCurrentSurface(EGL_DRAW), &id)) return -1;
+    return (jlong) id;
+}
+
+/* out[0]: the GPU finished the frame, out[1]: the display showed it, in ns
+ * of CLOCK_MONOTONIC (uptimeMillis' clock); -2 not known yet, -1 never
+ * (out[1] -1: the frame was replaced before the display took it).
+ * Returns 0 if Android no longer knows the frame. */
+JNIEXPORT jint JNICALL
+Java_com_winlator_saipen_GlassTimes_nativeTimes(JNIEnv *env, jclass cls, jlong frameId, jlongArray out) {
+    if (getFrameTimestamps == NULL) return 0;
+    const EGLint names[2] = {EGL_RENDERING_COMPLETE_TIME_ANDROID, EGL_DISPLAY_PRESENT_TIME_ANDROID};
+    EGLnsecsANDROID values[2] = {0, 0};
+    if (!getFrameTimestamps(eglGetCurrentDisplay(), eglGetCurrentSurface(EGL_DRAW),
+                            (EGLuint64KHR) frameId, 2, names, values)) return 0;
+    jlong v[2] = {(jlong) values[0], (jlong) values[1]};
+    (*env)->SetLongArrayRegion(env, out, 0, 2, v);
+    return 1;
+}
